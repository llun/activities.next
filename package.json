{
  "name": "activities.next",
  "version": "1.195.9",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && oxlint -c lint/oxlintrc.scripts.json scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prettier": "prettier --write app migrations lib lint test",
    "prettier:check": "prettier --check app migrations lib lint test",
    "search:reindex": "node scripts/run.cjs scripts/maintenance/rebuildSearchIndex.ts",
    "migrate": "node scripts/run.cjs scripts/database/migrate.ts latest",
    "migrate:make": "node scripts/run.cjs scripts/database/migrate.ts make",
    "migrate:status": "node scripts/run.cjs scripts/database/migrate.ts status",
    "migrate:down": "node scripts/run.cjs scripts/database/migrate.ts down",
    "migrate:unlock": "node scripts/run.cjs scripts/database/migrate.ts unlock",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "arrowParens": "always",
    "requirePragma": false,
    "trailingComma": "none",
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "importOrder": [
      "<THIRD_PARTY_MODULES>",
      "^@/(.*)$",
      "^[./]"
    ],
    "importOrderParserPlugins": [
      "typescript",
      "decorators-legacy",
      "jsx"
    ],
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ]
  },
