{
  // Full-project type check (`yarn typecheck`): everything tsconfig.json
  // includes — production code, scripts/ AND *.test.ts(x) — minus the ratchet
  // below. `next build` covers the non-test files through tsconfig.build.json;
  // this is the only type gate for test files.
  "extends": "./tsconfig.json",
  // `exclude` REPLACES the inherited list, so the base entries are repeated.
  "exclude": [
    "node_modules",
    "plans",
    "vitest.setup.ts",
    "vitest-shims",

    // ---- Ratchet ----------------------------------------------------------
    // Test files carrying type errors that predate this gate. Only
    // *.test.ts(x) may appear here. Remove a file in the PR that makes it
    // type-clean; NEVER add one — a new or edited test file must pass. When
    // this list is empty, delete this file and point `yarn typecheck` at

    "lib/components/posts/status-translation.test.tsx",
    "next.config.test.ts",
    "scripts/backup/productionArchive.test.ts",
    "scripts/fitness/gearImportPlan.test.ts"
  ]
}
