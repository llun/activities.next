#!/usr/bin/env bash
# This hook's own exit status can replace the job's recorded exit status
# (Buildkite job-lifecycle hooks), so it must never fail the job over a
# status-posting problem. Capture the real outcome first, run the (possibly
# failing) status post in a subshell so it can't abort this script, then
# always exit with the original, real outcome.
set -uo pipefail

original_exit_status="${BUILDKITE_COMMAND_EXIT_STATUS:-1}"

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../scripts/github-status.sh
source "$DIR/scripts/github-status.sh"

if [ "$original_exit_status" = "0" ]; then
  ( post_github_status "success" "Passed" ) || echo "github-status: failed to post success status" >&2
else
  ( post_github_status "failure" "Failed" ) || echo "github-status: failed to post failure status" >&2
fi

exit "$original_exit_status"
